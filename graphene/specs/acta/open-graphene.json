{
  "x-open-graphene": {
    "chain": "acta",
    "kind": "chain-bundle",
    "networks": [
      {
        "addressPrefix": "RQRX",
        "chainId": "eebc39f87af38798f23157a28ed1838e481a4ec71fefa19a033e623911af6e5d",
        "default": true,
        "endpoints": [
          {
            "label": "Chainpool node 01",
            "priority": 100,
            "transport": "websocket",
            "url": "wss://node01.acta.chainpool.online:8090"
          },
          {
            "label": "Chainpool node 02",
            "priority": 90,
            "transport": "websocket",
            "url": "wss://node02.acta.chainpool.online:8090"
          }
        ],
        "label": "Acta Mainnet",
        "name": "mainnet"
      },
      {
        "label": "Acta Testnet",
        "name": "testnet"
      }
    ],
    "surfaces": [
      {
        "apiQualifiedName": "graphene::app::database_api",
        "kind": "database",
        "name": "acta-database",
        "spec": "api.database.json"
      },
      {
        "apiQualifiedName": "graphene::app::network_broadcast_api",
        "kind": "broadcast",
        "name": "acta-broadcast",
        "spec": "api.network-broadcast.json"
      }
    ],
    "version": "0.1.0"
  }
}
